{
  "name": "playwright-saucedemo-automation",
  "version": "1.0.0",
  "description": "End-to-end test automation framework using Playwright",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing"
  ],
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5"
  }
}
